<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  OPEN GROUND entitlements for hardened-runtime signing + notarization.

  The app is a launcher that runs `npm run dev` (Node.js + node-pty +
  child-process spawn of `claude`) and opens a Chrome "app mode" window
  pointed at the local dev server, so it needs:

    com.apple.security.cs.allow-jit                  — node's V8 JIT
    com.apple.security.cs.allow-unsigned-executable-memory
                                                     — same, JIT pages
    com.apple.security.cs.disable-library-validation — npm modules (e.g.
                                                       node-pty native
                                                       binding) are not
                                                       Apple-signed
    com.apple.security.cs.allow-dyld-environment-variables
                                                     — nvm's PATH munging
    com.apple.security.inherit                       — child processes
                                                       inherit the same
                                                       entitlement set

  Sandboxing is intentionally OFF — the whole point of OPEN GROUND is
  to read the user's project tree and spawn shell commands in it. A
  sandboxed build would defeat the cockpit.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.inherit</key>
  <true/>
</dict>
</plist>
