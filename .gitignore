# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/playwright-report
/test-results
/playwright/.cache

# next.js
/.next/
/out/

# production
# build/ is electron-builder's buildResources dir. Ignore its contents EXCEPT
# the committed signing/icon resources electron-builder needs at dist time —
# otherwise a fresh clone / CI loses the app icon and entitlements.
/build/*
!/build/icon.icns
!/build/icon.ico
!/build/entitlements.mac.plist
!/build/entitlements.mac.inherit.plist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# build-time-baked PUBLIC app-login config — electron/runtimeConfig.js writes it
# from CI Secrets/Vars during `npm run build` and ships it inside the .app. It
# holds only the public anon key (never the service-role key), but is generated
# per build, so it is never committed. See docs/AUTH_SETUP.md §6.
/electron/runtime-config.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated desktop launcher (rebuild with scripts/make-app.sh)
/OPEN GROUND.app
/OpenGround.app
/Hove.app
/PMmap.app

# distributable bundles (produced by scripts/sign-and-notarize.sh)
/OPEN-GROUND.app.zip

# electron-builder output
/dist/
/dist-electron/

# vite SPA build output (served by Hono in prod)
/dist-web/

# esbuild server bundle output (forked by Electron in prod)
/server/dist/

# OPEN GROUND's own per-project data (local user state)
/.openground/

# MCP server config — contains a Supabase Personal Access Token (account-level
# secret). NEVER commit this; it is a per-developer local file.
/.mcp.json

# Claude Code runtime artifacts (transient — regenerated by /loop, /schedule).
/.claude/scheduled_tasks.lock
