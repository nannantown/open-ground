# dependencies
/node_modules
# CF worker package artifacts (its own node_modules + local wrangler state/build)
/worker/node_modules
/worker/.wrangler
/worker/dist
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/playwright-report
/test-results
/playwright/.cache

# next.js
/.next/
/out/

# production
# build/ is electron-builder's buildResources dir. Ignore its contents EXCEPT
# the committed signing/icon resources electron-builder needs at dist time —
# otherwise a fresh clone / CI loses the app icon and entitlements.
/build/*
!/build/icon.icns
!/build/icon.ico
!/build/entitlements.mac.plist
!/build/entitlements.mac.inherit.plist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# build-time-baked PUBLIC app-login config — electron/runtimeConfig.js writes it
# from CI Secrets/Vars during `npm run build` and ships it inside the .app. It
# holds only the public anon key (never the service-role key), but is generated
# per build, so it is never committed. See docs/AUTH_SETUP.md §6.
/electron/runtime-config.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated desktop launcher (rebuild with scripts/make-app.sh)
/OPEN GROUND.app
/OpenGround.app
/Hove.app
/PMmap.app

# distributable bundles (produced by scripts/sign-and-notarize.sh)
/OPEN-GROUND.app.zip

# electron-builder output
/dist/
/dist-electron/

# vite SPA build output (served by Hono in prod)
/dist-web/

# esbuild server bundle output (forked by Electron in prod)
/server/dist/

# OPEN GROUND's own per-project data (local user state)
/.openground/

# Proxy judgment corpus ("you-corpus") — the externalised decision axis. It is
# PERSONAL data that lives only under ~/.openground (never in-repo). These
# unanchored patterns are DEFENSIVE: if a misconfigured CLI ever writes a corpus
# into the work tree, it must never be committed.
you-corpus.md
you-corpus-additions.json
# corruption-recovery backups (the FULL prior judgment history) — must never be
# committed if OPENGROUND_HOME is ever misconfigured into the repo. Specific
# (not `you-corpus*`) so it can't shadow the tracked scripts/you-corpus.ts.
you-corpus-additions.json.corrupt-*

# MCP server config — contains a Supabase Personal Access Token (account-level
# secret). NEVER commit this; it is a per-developer local file.
/.mcp.json

# Claude Code runtime artifacts (transient — regenerated by /loop, /schedule).
/.claude/scheduled_tasks.lock

# Throwaway "fake real home" dirs created by the production-home fence teeth
# (src/lib/server/testHomeGuard.test.ts). They must live OUTSIDE any OS temp
# location — every temp path is trusted by construction, so a probe home built
# there would pass for the wrong reason — which is why they land at the repo
# root. The test removes them in a finally; this covers a killed run.
/.og-fence-probe-*
